# Добавь этот блок в /etc/nginx/sites-available/dacha-api
# и сделай symlink: ln -s /etc/nginx/sites-available/dacha-api /etc/nginx/sites-enabled/

# HTTP → HTTPS редирект.
# ВАЖНО: используй $uri$is_args$args, НЕ $request_uri.
# В цепочке двойного nginx-проксирования (внешний 443 → внутренний 10443) переменная
# $request_uri может приходить искажённой (обрезанный последний символ) → сломанный
# Location заголовок → Яндекс считает robots.txt недоступным → блокировка индексации.
# $uri нормализуется самим nginx-ом и всегда корректен. (грабли 2026-09-07)
server {
    listen 80;
    server_name api.dacha-your-domain.ru;  # замени на свой домен или IP
    return 301 https://$host$uri$is_args$args;
}

server {
    listen 127.0.0.1:10443 ssl;  # локальный порт для внешнего фронт-роутера
    server_name api.dacha-your-domain.ru;  # замени на свой домен или IP

    ssl_certificate     /etc/letsencrypt/live/api.dacha-your-domain.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.dacha-your-domain.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass         http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }
}
